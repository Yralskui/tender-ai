# TenderAI — пример переменных окружения

# JWT
JWT_SECRET=change-me-in-production

# Groq AI
GROQ_API_KEY=

# Автосинхронизация (cron)
CRON_SECRET=change-me-cron-secret

# URL приложения (ссылки в письмах). В проде: https://ваш-проект.fly.dev
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Прод: каталог на volume (Fly.io задаёт автоматически в fly.toml)
# PERSIST_DIR=/data

# Dev: хосты для доступа с других устройств (через запятую, без порта)
DEV_ALLOWED_ORIGINS=192.168.0.171

# Email (SMTP) — Yandex, Mail.ru, Gmail app password и т.д.
# Без SMTP письма логируются в консоль сервера (удобно для разработки)
SMTP_HOST=smtp.bk.ru
SMTP_PORT=465
SMTP_USER=tender-ai@bk.ru
SMTP_PASS=app-password
SMTP_FROM="TenderAI <tender-ai@bk.ru>"

# Опционально: если SMTP блокируется провайдером (порт 465/587), Resend через HTTPS
# RESEND_API_KEY=re_...
# RESEND_FROM=TenderAI <onboarding@resend.dev>
