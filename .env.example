# TenderAI — пример переменных окружения

# JWT
JWT_SECRET=change-me-in-production

# Groq AI
GROQ_API_KEY=

# Автосинхронизация (cron / worker)
CRON_SECRET=change-me-cron-secret

# URL приложения (ссылки в письмах). В проде: https://ваш-домен.ru
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Производительность и деплой ---
# Прод: фоновые задачи только в worker (npm run worker)
# BACKGROUND_JOBS_IN_NEXT=0

# База: SQLite локально (по умолчанию dev.db), Postgres в проде
# DATABASE_URL=postgresql://tender:tender@localhost:5432/tenderai

# Redis — кэш счётчиков (опционально в dev)
# REDIS_URL=redis://localhost:6379

# Очередь HTTP к zakupki.gov.ru
ZAKUPKI_HTTP_CONCURRENCY=2
ZAKUPKI_HTTP_MIN_GAP_MS=400
# С июля 2024 zakupki.gov.ru на отечественном сертификате Минцифры.
# Скачайте корневой CA: https://www.gosuslugi.ru/crt → сохраните .pem и укажите путь:
# ZAKUPKI_CA_FILE=./certs/russian_trusted_root_ca.pem
# Альтернатива: NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem

# Отключить планировщик в Next (если worker отдельно)
# AUTO_SYNC_DISABLE=1

# Интервал авто-синка (мс), по умолчанию 20 мин
# AUTO_SYNC_INTERVAL_MS=1200000

# Прод: каталог на volume (Fly.io задаёт автоматически в fly.toml)
# PERSIST_DIR=/data

# Dev: хосты для доступа с других устройств (через запятую, без порта)
DEV_ALLOWED_ORIGINS=192.168.0.171

# Email (SMTP)
SMTP_HOST=smtp.bk.ru
SMTP_PORT=465
SMTP_USER=tender-ai@bk.ru
SMTP_PASS=app-password-from-mail-ru
SMTP_FROM="TenderAI <tender-ai@bk.ru>"

# Опционально: Resend через HTTPS
# RESEND_API_KEY=re_...
# RESEND_FROM=TenderAI <onboarding@resend.dev>
